            "$ref": "#/$defs/evidence_tier"
          }
        },
        "required": [
          "net",
          "family",
          "violation",
          "severity",
          "pins",
          "corroboration",
          "evidence",
          "activation",
          "reason",
          "evidence_tier"
        ]
      }
    },
    "not_checked_parts": {
      "type": "array",
      "description": "Parts a checker did not check, one entry per part; [] when none. Not a status: no board verdict reads it.",
      "items": {
        "type": "object",
        "description": "One disclosure per part a checker did not check. Common keys on every entry; each known reason adds its own required keys.",
        "properties": {
          "refdes": {
            "type": "string"
          },
          "part_number": {
            "$ref": "#/$defs/part_number"
          },
          "checker": {
            "type": "string",
            "description": "Which checker did not check the part. Open string; known values: signal, supply, all."
          },
          "reason": {
            "$ref": "#/$defs/reason_code",
            "description": "Why the part was not checked. Open code list: a reader must tolerate a code it does not know (an entry with an unknown reason is checked on these common keys only). Known codes: NON_IC_PART, MERGED_REFDES, SAME_INSTANCE.",
            "x-known-codes": [
              "NON_IC_PART",
              "MERGED_REFDES",
              "SAME_INSTANCE"
            ]
          },
          "part_class": {
            "type": "string"
          },
          "class_evidence": {
            "type": "string"
          },
          "nets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pins_with_rows": {
            "$ref": "#/$defs/count"
          },
          "records": {
            "$ref": "#/$defs/count"
          },
          "sheet_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "part_numbers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/part_number"
            }
          },
          "collided_pins": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pin": {
                  "type": "string"
                },
                "nets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "pin",
                "nets"
              ]
            }
          },
          "test": {
            "type": "string"
          }
        },
        "required": [
          "refdes",
          "part_number",
          "checker",
          "reason"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "NON_IC_PART"
                }
              },
              "required": [
                "reason"
              ]
            },
            "then": {
              "required": [
                "part_class",
                "class_evidence",
                "nets",
                "pins_with_rows"
              ],
              "description": "NON_IC_PART (TODO-554): a recognised non-IC part. With checker signal, a signal-net pin left without a row (a part classed protection_diode is never a signal endpoint, TODO-556 decision 17); with checker supply (TODO-556 decision 27), a part classed connector whose supply pins get no power_supply_results row (pins_with_rows is then 0)."
            }
          },
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "MERGED_REFDES"
                }
              },
              "required": [
                "reason"
              ]
            },
            "then": {
              "required": [
                "records",
                "sheet_paths",
                "part_numbers",
                "collided_pins",
                "test"
              ],
              "description": "MERGED_REFDES (TODO-569): a reference designator the netlist merges; part_number is null when the ref has no (comp) record."
            }
          },
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "SAME_INSTANCE"
                }
              },
              "required": [
                "reason"
              ]
            },
            "then": {
              "required": [
                "nets",
                "pins",
                "pins_with_rows"
              ],
              "description": "SAME_INSTANCE (TODO-556 decision 16, TODO-567): signal rows whose receiver is the same part instance as the net's driver are not emitted; one entry per part names the nets and pins of those rows, and pins_with_rows counts the part's own (net, pin) receiver rows that remain."
            }
          }
        ]
      }
    },
    "power_rails_confirmed": {
      "type": "object",
      "description": "Net name -> confirmed voltage (null when not confirmed).",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "drift_warning": {
      "type": "string",
      "description": "Present only when at least one finding is cache_drift. Key covered; wording not."
    },
    "staged_cache_notice": {
      "type": "object",
      "description": "Present only when a cache was served from the staging tier. Keys covered; message wording not.",
      "properties": {
        "message": {
          "type": "string"
        },
        "staged_stems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "message",
        "staged_stems"
      ]
    },
    "not_checked_pins": {
      "type": "array",
      "description": "Pins a checker did not check, one entry per pin; build_report always writes it ([] when none), but it is not required, so a report without it still validates. Not a status: no board verdict reads it. First producer: step_08b, reason OWN_SUPPLY_PIN (TODO-556 decision 19); the shape is also reserved for TODO-559 (strap pins).",
      "items": {
        "type": "object",
        "properties": {
          "refdes": {
            "type": "string"
          },
          "part_number": {
            "$ref": "#/$defs/part_number"
          },
          "pin_name": {
            "type": "string"
          },
          "net": {
            "type": "string"
          },
          "checker": {
            "type": "string",
            "description": "Which checker did not check the pin. Open string; known values: supply."
          },
          "reason": {
            "$ref": "#/$defs/reason_code",
            "description": "Why the pin was not checked. Open code list: a reader must tolerate a code it does not know. Known codes: OWN_SUPPLY_PIN.",
            "x-known-codes": [
              "OWN_SUPPLY_PIN"
            ]
          },
          "token": {
            "type": "string"
          },
          "symbol_name": {
            "type": "string"
          }
        },
        "required": [
          "refdes",
          "part_number",
          "pin_name",
          "net",
          "checker",
          "reason"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "OWN_SUPPLY_PIN"
                }
              },
              "required": [
                "reason"
              ]
            },
            "then": {
              "required": [
                "token"
              ],
              "description": "OWN_SUPPLY_PIN (TODO-556 decision 19): a supply-admitted pin whose name, or for a numeric pin name its libparts symbol name (symbol_name), carries an own regulator-output / core-capacitor / bootstrap token (token), on a net with no voltage; it gets no power_supply_results row."
            }
          }
        ]
      }
    },
    "extraction_metadata": {
      "description": "NOT COVERED by the 1.0 promise: per-part extraction details keyed by the part number as the netlist wrote it (keys are not stripped)."
    },
    "rail_candidates": {
      "description": "NOT COVERED by the 1.0 promise (present on main.py reports)."
    },
    "rail_map_conflicts": {
      "description": "NOT COVERED by the 1.0 promise."
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "provenance",
    "source_netlist",
    "summary",
    "results",
    "power_supply_results",
    "structural_integrity_results",
    "peripheral_integrity_results",
    "pullup_value_results",
    "output_conflict_results",
    "pullup_presence_results",
    "not_checked_parts",
    "power_rails_confirmed"
  ],
  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "WARN",
        "FAIL",
        "UNRESOLVABLE"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"
    },
    "reason_code_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"
    },
    "part_number": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?!\\s)(?:.*\\S)?(?![\\s\\S])",
      "description": "A part number with no leading or trailing whitespace, or null."
    },
    "evidence_tier": {
      "enum": [
        "confirmed_local",
        "cache_drift",
        "cache_unverified",
        "assumed",
        "not_cache_derived"
      ],
      "description": "Which kind of evidence backs the row (closed list; the five-value tier vocabulary is frozen in step_10_report.py)."
    },
    "count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
